# Editors / IDEs
# =========================

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# Eclipse metadata generated by importing server-java into an IDE.
# NOT a blanket rule: fixtures/java deliberately commits .project/.classpath —
# they are what lets jdt.ls import the fixture offline.
.settings/
server-java/.project
server-java/.classpath

# VS Code: share the project-level configs, ignore personal state.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json

# Coverage and local caches
# =========================

coverage/
site/_site/
*.lcov
# only if someone builds with -Dmaven.repo.local in-tree
.m2repo/
# only if JDTLS_HOME is pointed inside the repo
.jdtls/
